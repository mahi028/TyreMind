# ---- secrets ----
.env
.env.local
*.key
credentials.json

# ---- python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
!apps/web/dist/
!apps/web/dist/**
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- data (large / regenerable) ----
data/raw/
data/interim/
data/processed/
data/external/
cache/
fastf1_cache/
*.parquet
# Demo cache IS committed: the offline demo must work on a fresh clone.
!data/demo/*.parquet
!data/demo/*.json

# ---- node ----
node_modules/
# apps/web/dist/ is deliberately NOT ignored. The built dashboard is committed so
# that a clone runs with Python alone -- no Node, no npm install, no build step.
# Rebuild and re-commit it after any frontend change:  npm --prefix apps/web run build
apps/web/.vite/
*.log

# ---- os / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# Internal build notes, kept locally and not published.
Prompt.md

# Rendered demo video. Kept out of git because a 28 MB binary in history costs
# every clone forever, and the distribution channel is Drive, not GitHub.
# Regenerate with: python scripts/record_demo.py docs/video/TyreMind_Demo.mp4
docs/video/*.mp4
docs/video/*.webm
docs/video/*.png

# Research corpus. Hundreds of sessions, gigabytes; rebuilt with
#     python scripts/build_corpus.py --years 2024 2023 2022 --sessions R FP2 FP1 FP3
# data/demo/ stays committed so a clone still runs offline.
data/season/

# Downloaded papers. Deliberately not committed:
#   1. this is a public repository, and arXiv's default licence grants arXiv the
#      right to distribute, not us -- publisher PDFs even less so;
#   2. 117 MB of binaries would permanently enlarge a 3.4 MB repo's history.
# `research/papers/INDEX.json` records every citation and URL, and one command
# rebuilds the whole collection:  python scripts/fetch_papers.py
research/papers/**/*.pdf
research/papers/*.zip

# Per-lap telemetry features. Rebuilt with scripts/build_telemetry.py; gigabytes
# of derived data that the corpus can regenerate.
data/telemetry/

# Extracted paper text. Same reason as the PDFs: this is the full text of other
# people's papers in a public repository. Regenerated from the PDFs on demand.
research/notes/

# Exported track geometry, rebuilt with scripts/export_track_geometry.py
data/geometry/

# Prompt handed to the visualisation agent directly, deliberately not in the repo.
docs/PROMPT_3D_VISUALISATION.md
